{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitBody": "Update-Type: {{updateType}}",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in workflow inputs, marked with a `# renovate:` comment",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[\\w-]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": [
    "before 5am"
  ]
}
